# Copy to private mode-0600 file; generate distinct strong tokens.
DATABASE_URL=postgresql://forgeflow:replace@127.0.0.1:5432/forgeflow
FORGEFLOW_BIND=127.0.0.1:8787
FORGEFLOW_DATA_ROOT=/srv/forgeflow/data
FORGEFLOW_CONSOLE_DIR=/opt/forgeflow/console
FORGEFLOW_PROJECT_ROOT=/srv/forgeflow/projects
FORGEFLOW_OWNER_PASSWORD=replace-with-at-least-12-characters
FORGEFLOW_OWNER_TOKEN=replace-with-random-owner-service-token
FORGEFLOW_WORKER_TOKEN=replace-with-distinct-random-worker-token
FORGEFLOW_DATABASE_PASSWORD=replace-with-random-database-password
