{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "x-status": "DRAFT_NOT_ADMITTED",
  "title": "ForgeFlow ECP error envelope v2",
  "required": [
    "code",
    "message",
    "retryable",
    "operation_id",
    "schema_version"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_.-]{2,63}$",
      "not": {
        "pattern": "[^A-Z0-9_.-]"
      }
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "retryable": {
      "type": "boolean"
    },
    "operation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "current_revision": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "maxLength": 19,
          "pattern": "^(?:0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
          "not": {
            "pattern": "[^0-9]"
          }
        }
      ],
      "description": "Optional nonnegative PostgreSQL bigint; decimal strings preserve 64-bit precision."
    },
    "details_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "const": 2
    }
  },
  "$id": "urn:forgeflow:ecp:error:v2",
  "x-contract-version": 2
}
