{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "x-status": "DRAFT_NOT_ADMITTED",
  "title": "ForgeFlow ECP command context v2",
  "required": [
    "schema_version",
    "operation_id",
    "principal_id",
    "workspace_id",
    "expected_revision",
    "idempotency_key",
    "request_digest",
    "trace_id"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "principal_id": {
      "type": "string",
      "minLength": 1,
      "readOnly": true
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "capability_grant_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "authorization_epoch": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "maxLength": 19,
          "pattern": "^(?:0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
          "not": {
            "pattern": "[^0-9]"
          }
        }
      ],
      "description": "Nonnegative PostgreSQL bigint; use a canonical decimal string above JavaScript max safe integer."
    },
    "expected_revision": {
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "object",
            "membership",
            "lease_generation",
            "create_if_absent"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "request_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$",
      "not": {
        "pattern": "[^a-f0-9]"
      }
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "$id": "urn:forgeflow:ecp:command-context:v2",
  "x-contract-version": 2
}
