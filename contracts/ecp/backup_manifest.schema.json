{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"x-status":"DESIGN_DRAFT_NOT_IMPLEMENTATION","title":"ForgeFlow ECP backup manifest v1","required":["schema_version","source_sha","data_root","database_dump_sha256","artifact_manifest_sha256","project_event_watermarks","dispatch_paused","unsettled_attempts","file_quiescence_checked","rpo_seconds","rto_seconds"],"properties":{"schema_version":{"const":"forgeflow.ecp-backup.v1"},"source_sha":{"type":"string","minLength":40},"data_root":{"type":"string","minLength":1},"database_dump_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"artifact_manifest_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"project_event_watermarks":{"type":"object"},"dispatch_paused":{"const":true},"unsettled_attempts":{"const":0},"rpo_seconds":{"type":"integer","minimum":0},"rto_seconds":{"type":"integer","minimum":0},"old_leases_revoked":{"type":"boolean"},"file_quiescence_checked":{"const":true}}}
