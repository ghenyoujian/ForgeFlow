{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "x-status": "DRAFT_NOT_ADMITTED",
  "title": "ForgeFlow ECP error envelope v1",
  "required": ["code", "message", "retryable", "operation_id"],
  "properties": {
    "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_.-]{2,63}$"},
    "message": {"type": "string", "minLength": 1, "maxLength": 4096},
    "retryable": {"type": "boolean"},
    "operation_id": {"type": ["string", "null"]},
    "current_revision": {"type": ["integer", "string", "null"]},
    "details_ref": {"type": ["string", "null"]},
    "reason": {"type": ["string", "null"]}
  }
}
