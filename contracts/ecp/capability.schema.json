{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "x-status": "DESIGN_DRAFT_NOT_IMPLEMENTATION",
  "title": "ForgeFlow capability grant v1",
  "required": ["grant_id", "workspace_id", "principal_id", "action_set", "project_set", "write_set", "executor_set", "budget", "authorization_epoch", "revision"],
  "properties": {
    "grant_id": {"type": "string", "minLength": 1},
    "workspace_id": {"type": "string", "minLength": 1},
    "principal_id": {"type": "string", "minLength": 1},
    "issuer_principal_id": {"type": ["string", "null"]},
    "parent_grant_id": {"type": ["string", "null"]},
    "action_set": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "project_set": {"type": "array", "items": {"type": "string"}},
    "write_set": {"type": "array", "items": {"type": "string"}},
    "executor_set": {"type": "array", "items": {"type": "string"}},
    "budget": {"type": "object"},
    "authorization_epoch": {"type": "integer", "minimum": 1},
    "revision": {"type": "integer", "minimum": 1},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "revoked_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
