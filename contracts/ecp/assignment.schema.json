{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "x-status": "DESIGN_DRAFT_NOT_IMPLEMENTATION",
  "title": "ForgeFlow ECP assignment v1",
  "required": ["assignment_id", "workspace_id", "issuer_principal_id", "assignee_principal_id", "action_set", "project_set", "write_set", "executor_set", "budget", "status", "revision", "request_key"],
  "properties": {
    "assignment_id": {"type": "string", "minLength": 1},
    "workspace_id": {"type": "string", "minLength": 1},
    "project_id": {"type": ["string", "null"]},
    "task_id": {"type": ["string", "null"]},
    "issuer_principal_id": {"type": "string", "minLength": 1},
    "assignee_principal_id": {"type": "string", "minLength": 1},
    "parent_grant_id": {"type": ["string", "null"]},
    "action_set": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "project_set": {"type": "array", "items": {"type": "string"}},
    "write_set": {"type": "array", "items": {"type": "string"}},
    "executor_set": {"type": "array", "items": {"type": "string"}},
    "budget": {"type": "object"},
    "status": {"enum": ["OFFERED", "ACCEPTED", "DECLINED", "REVOKED", "EXPIRED"]},
    "revision": {"type": "integer", "minimum": 1},
    "expected_revision": {"type": ["integer", "null"], "minimum": 1},
    "request_key": {"type": "string", "minLength": 16, "maxLength": 128},
    "expires_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
