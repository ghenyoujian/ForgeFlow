{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forgeflow:ecp:resume:v1",
  "type": "object",
  "additionalProperties": false,
  "x-status": "DRAFT_NOT_ADMITTED",
  "required": ["schema_version", "attempt_id", "generation", "epoch", "resume_kind", "native_session_id", "evidence_status"],
  "properties": {
    "schema_version": {"const": "forgeflow.ecp.resume.v1"},
    "attempt_id": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 1},
    "epoch": {"type": "integer", "minimum": 1},
    "resume_kind": {"enum": ["NATIVE_RESUME", "NEW_ATTEMPT", "UNSUPPORTED"]},
    "native_session_id": {"type": ["string", "null"]},
    "evidence_status": {"enum": ["VERIFIED", "FAILED", "INCONCLUSIVE", "NOT_RUN", "BLOCKED"]},
    "receipt_ref": {"type": ["string", "null"]}
  }
}
