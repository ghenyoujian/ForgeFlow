{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input_revision",
    "start_at",
    "end_at"
  ],
  "properties": {
    "input_revision": {
      "$ref": "urn:forgeflow:planning-scenario:v1#/$defs/Unsigned64",
      "description": "Required project event cursor from planning-inputs. Guarded exactly only when planning_input_digest is omitted/null."
    },
    "planning_input_digest": {
      "type": [
        "string",
        "null"
      ],
      "default": null,
      "description": "Echo the server-opaque planning-inputs digest. When present, this guard takes precedence over input_revision; fresh allocation counters may differ."
    },
    "start_at": {
      "type": "string",
      "format": "date-time"
    },
    "end_at": {
      "type": "string",
      "format": "date-time"
    },
    "availability": {
      "type": "array",
      "items": {
        "$ref": "urn:forgeflow:planning-scenario:v1#/$defs/PlanningAvailabilityWindow"
      },
      "maxItems": 256,
      "default": [],
      "description": "Positive, nonoverlapping working intervals inside the outer bounds. Empty/omitted means one interval using start_at/end_at. Their first-to-last span must not exceed 366 days; jobs must fit a whole interval."
    },
    "worker_scope_id": {
      "type": [
        "string",
        "null"
      ],
      "default": null,
      "description": "Optional scope_id whose snapshot resource policy has a non-null worker_id. This does not verify a live worker or its execution binding."
    },
    "task_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": [],
      "description": "Current snapshot task IDs. Empty/omitted selects all unfinished tasks. Dependencies are not added automatically; selecting only a successor can produce MISSING_PREDECESSOR."
    },
    "duration_overrides": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 1000000
      },
      "default": {},
      "description": "Positive elapsed-duration hours keyed by a current task ID. Override keys need not be in the selected subset; unknown keys are rejected."
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forgeflow:planning-scenario:v1",
  "title": "PlanningScenarioRequest",
  "description": "POST /api/v1/projects/{project}/planning-scenarios request. Computes a read-only forecast from a fresh repeatable-read snapshot; persists no scenario or schedule and requires no Idempotency-Key. Owner authentication is required; cookie POSTs still require X-CSRF-Token. The server checks end_at > start_at, interval ordering, task existence and graph/window budgets.",
  "$defs": {
    "Unsigned64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "PlanningAvailabilityWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_at",
        "end_at"
      ],
      "properties": {
        "start_at": {
          "type": "string",
          "format": "date-time"
        },
        "end_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "PlanningForecastTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "owner_id",
        "team_id",
        "planned_start",
        "planned_end",
        "duration_hours",
        "duration_source",
        "critical_dependency_path",
        "dependency_slack_hours",
        "resource_or_calendar_wait_hours",
        "scope_ids"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "owner_id": {
          "type": "string"
        },
        "team_id": {
          "type": "string"
        },
        "planned_start": {
          "type": "string",
          "format": "date-time"
        },
        "planned_end": {
          "type": "string",
          "format": "date-time"
        },
        "duration_hours": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000
        },
        "duration_source": {
          "enum": [
            "USER_SCENARIO_OVERRIDE",
            "REVIEWED_TASK_ESTIMATE",
            "CURRENT_PLAN_INTERVAL"
          ]
        },
        "critical_dependency_path": {
          "type": "boolean"
        },
        "dependency_slack_hours": {
          "type": "number",
          "minimum": 0
        },
        "resource_or_calendar_wait_hours": {
          "type": "number",
          "minimum": 0
        },
        "scope_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "PlanningFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "code",
        "detail"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "code": {
          "enum": [
            "MISSING_PREDECESSOR",
            "DURATION_UNKNOWN",
            "PREDECESSOR_UNSCHEDULED",
            "RESOURCE_SCOPE_UNQUALIFIED",
            "NO_FEASIBLE_WINDOW"
          ]
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "PlanningForecast": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "rows",
        "blocked",
        "dependency_lower_bound_hours",
        "complete",
        "assumptions"
      ],
      "properties": {
        "algorithm": {
          "const": "PRIORITIZED_NON_PREEMPTIVE_RESOURCE_LEVELING_V1"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "urn:forgeflow:planning-scenario:v1#/$defs/PlanningForecastTask"
          }
        },
        "blocked": {
          "type": "array",
          "items": {
            "$ref": "urn:forgeflow:planning-scenario:v1#/$defs/PlanningFinding"
          }
        },
        "dependency_lower_bound_hours": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Dependency-only lower bound, excluding resource/calendar waits; null if input dependencies/durations are invalid or there are no planned tasks."
        },
        "complete": {
          "type": "boolean",
          "description": "True only when every selected unfinished planning task receives a forecast row."
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "PlanningScenarioData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forecast",
        "input_revision",
        "requested_revision",
        "planning_input_digest",
        "input_changed_since_request",
        "as_of",
        "source",
        "worker_scope_id",
        "execution_rights_granted",
        "qualification",
        "worker_placement"
      ],
      "properties": {
        "forecast": {
          "$ref": "urn:forgeflow:planning-scenario:v1#/$defs/PlanningForecast"
        },
        "input_revision": {
          "$ref": "urn:forgeflow:planning-scenario:v1#/$defs/Unsigned64"
        },
        "requested_revision": {
          "$ref": "urn:forgeflow:planning-scenario:v1#/$defs/Unsigned64"
        },
        "planning_input_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_changed_since_request": {
          "type": "boolean",
          "description": "Reports only whether the project event cursor differs from requested_revision. A matching digest can succeed when this is true."
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "const": "POSTGRESQL_REPEATABLE_READ"
        },
        "worker_scope_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "execution_rights_granted": {
          "const": false
        },
        "qualification": {
          "const": "PLANNING_PROJECTION_ONLY"
        },
        "worker_placement": {
          "enum": [
            "EXPLICIT_SCOPE",
            "UNVERIFIED"
          ],
          "description": "EXPLICIT_SCOPE means a resource-policy scope was requested, not verified live placement or Worker qualification."
        }
      }
    },
    "PlanningScenarioResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "read_model_version",
        "observed_at",
        "source",
        "next_cursor"
      ],
      "properties": {
        "data": {
          "$ref": "urn:forgeflow:planning-scenario:v1#/$defs/PlanningScenarioData"
        },
        "read_model_version": {
          "type": "null"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "const": "postgres"
        },
        "next_cursor": {
          "type": "null"
        }
      }
    },
    "DomainError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "object_id",
        "request_id",
        "retryable",
        "remediation",
        "details"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "object_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "remediation": {
          "type": [
            "string",
            "null"
          ]
        },
        "details": {}
      }
    }
  }
}
