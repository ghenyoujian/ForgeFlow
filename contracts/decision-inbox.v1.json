{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forgeflow:decision-inbox:v1",
  "title": "ForgeFlow Owner decision inbox v1",
  "description": "Owner-only typed catalog commands. Open requires a real same-project paused non-Worker resource policy and current QUEUED task evidence. Duplicate cause/scope/policy revision aggregates to the existing verified decision. OPEN may acknowledge; OPEN/ACKNOWLEDGED may defer to a future revisit within 366 days without policy effects; ACKNOWLEDGED may resolve only the unchanged original bound policy revision. Resolve atomically unpauses only that policy and increments its revision together with decision/history/events, using catalog idempotency. Generic decisions/decision_history writes are forbidden; legacy generic documents remain readable but not actionable. No automatic deferred reopening, budget increases, Attempt/lease mutations, model calls or quota claims.",
  "oneOf": [
    {
      "$ref": "#/$defs/Decision"
    },
    {
      "$ref": "#/$defs/DecisionCommand"
    },
    {
      "$ref": "#/$defs/DecisionOutcome"
    }
  ],
  "$defs": {
    "ResourcePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worker_id",
        "scope_id",
        "parent_scope_id",
        "project_id",
        "team_id",
        "limits",
        "revision",
        "paused"
      ],
      "properties": {
        "worker_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "scope_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_scope_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "team_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "active_slot",
            "coding_slot",
            "cpu_units",
            "memory_bytes",
            "build_permit",
            "gpu_permit",
            "provider_inflight"
          ],
          "properties": {
            "active_slot": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "coding_slot": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "cpu_units": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "memory_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "build_permit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "gpu_permit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "provider_inflight": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            }
          }
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "paused": {
          "type": "boolean"
        }
      }
    },
    "DecisionBlockedTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "task_revision",
        "queue_revision"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "task_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "queue_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      }
    },
    "Decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "decision_id",
        "project_id",
        "cause",
        "state",
        "policy",
        "blocked_tasks",
        "note",
        "created_by",
        "created_at",
        "updated_at",
        "acknowledged_by",
        "acknowledged_at",
        "resolved_by",
        "resolved_at",
        "revisit_at",
        "resolution_reason",
        "revision"
      ],
      "properties": {
        "schema_version": {
          "const": "forgeflow.decision-inbox.v1"
        },
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "cause": {
          "const": "PAUSED_RESOURCE_POLICY"
        },
        "state": {
          "enum": [
            "OPEN",
            "ACKNOWLEDGED",
            "DEFERRED",
            "RESOLVED"
          ]
        },
        "policy": {
          "$ref": "#/$defs/ResourcePolicy"
        },
        "blocked_tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/DecisionBlockedTask"
          }
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "created_by": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "acknowledged_by": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "acknowledged_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolved_by": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "resolved_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "revisit_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolution_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      }
    },
    "DecisionCommand": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "const": "OPEN_PAUSED_POLICY"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "project_id",
                "scope_id",
                "expected_policy_revision",
                "note"
              ],
              "properties": {
                "project_id": {
                  "type": "string",
                  "minLength": 1
                },
                "scope_id": {
                  "type": "string",
                  "minLength": 1
                },
                "expected_policy_revision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9223372036854775807
                },
                "note": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "const": "ACKNOWLEDGE"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "project_id",
                "decision_id",
                "expected_revision",
                "note"
              ],
              "properties": {
                "project_id": {
                  "type": "string",
                  "minLength": 1
                },
                "decision_id": {
                  "type": "string",
                  "minLength": 1
                },
                "expected_revision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9223372036854775807
                },
                "note": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "const": "DEFER"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "project_id",
                "decision_id",
                "expected_revision",
                "revisit_at",
                "reason"
              ],
              "properties": {
                "project_id": {
                  "type": "string",
                  "minLength": 1
                },
                "decision_id": {
                  "type": "string",
                  "minLength": 1
                },
                "expected_revision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9223372036854775807
                },
                "revisit_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "const": "RESOLVE"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "project_id",
                "decision_id",
                "expected_revision",
                "expected_policy_revision",
                "reason"
              ],
              "properties": {
                "project_id": {
                  "type": "string",
                  "minLength": 1
                },
                "decision_id": {
                  "type": "string",
                  "minLength": 1
                },
                "expected_revision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9223372036854775807
                },
                "expected_policy_revision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9223372036854775807
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              }
            }
          }
        }
      ]
    },
    "DecisionOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "policy",
        "created",
        "policy_changed"
      ],
      "properties": {
        "decision": {
          "$ref": "#/$defs/Decision"
        },
        "policy": {
          "$ref": "#/$defs/ResourcePolicy"
        },
        "created": {
          "type": "boolean"
        },
        "policy_changed": {
          "type": "boolean"
        }
      }
    },
    "OPEN_PAUSED_POLICYHttpBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_id",
        "expected_policy_revision",
        "note"
      ],
      "properties": {
        "scope_id": {
          "type": "string",
          "minLength": 1
        },
        "expected_policy_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "ACKNOWLEDGEHttpBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_revision",
        "note"
      ],
      "properties": {
        "expected_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "DEFERHttpBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_revision",
        "revisit_at",
        "reason"
      ],
      "properties": {
        "expected_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "revisit_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "RESOLVEHttpBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_revision",
        "expected_policy_revision",
        "reason"
      ],
      "properties": {
        "expected_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "expected_policy_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    }
  },
  "x-http": {
    "list": "GET /api/v1/projects/{project}/decisions",
    "open": "POST /api/v1/projects/{project}/decisions",
    "get": "GET /api/v1/projects/{project}/decisions/{decision}",
    "acknowledge": "POST /api/v1/projects/{project}/decisions/{decision}/acknowledgments",
    "defer": "POST /api/v1/projects/{project}/decisions/{decision}/deferrals",
    "resolve": "POST /api/v1/projects/{project}/decisions/{decision}/resolutions",
    "write_header": "Idempotency-Key",
    "response": "CommandResult {operation_id,replayed,value:DecisionOutcome} project/decision identity is derived from route, reviewer from authenticated Owner"
  },
  "x-history": {
    "collection": "decision_history",
    "document_id": "{decision_id}:{decision_revision}",
    "immutable": true,
    "event_kinds": [
      "decision.opened",
      "decision.acknowledged",
      "decision.deferred",
      "resource_policy.updated",
      "decision.resolved"
    ]
  }
}
