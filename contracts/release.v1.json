    "CREATE_CANDIDATEHttpBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_revision",
        "expected_main_sha"
      ],
      "properties": {
        "expected_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "expected_main_sha": {
